{
    "name": "jlrodriguezdev/laravel-bot-protection",
    "description": "High-performance Laravel WAF & Anti-Bot Middleware mitigating automated scanners, scrapers, and exploit reconnaissance (including PHP2Shell)",
    "keywords": ["laravel", "security", "waf", "bot-protection", "anti-bot", "firewall", "crawlers", "scrapers", "php2shell"],
    "license": "MIT",
    "authors": [
        {
            "name": "jlrodriguezdev",
            "email": "cubanwebsite@gmail.com",
            "homepage": "https://github.com/jlrodriguezdev"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4|^8.5",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/http": "^9.0|^10.0|^11.0",
        "illuminate/cache": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Jlrodriguezdev\\BotProtection\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jlrodriguezdev\\BotProtection\\BotProtectionServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
